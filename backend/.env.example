APP_NAME=Geofencing & Location Event Detection System
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=mysql+aiomysql://geofence:geofence@mysql:3307/geofencing
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_BOUNDARY_TOLERANCE_METERS=10
MAX_POLYGON_POINTS=500
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
